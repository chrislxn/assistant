# ============================================================
# Personal AI Assistant — Environment Variables
# ============================================================
# cp .env.example .env  然后填入真实值

# ---- LLM API (kiwi-mem 用) ----
API_KEY=sk-your-api-key-here
API_BASE_URL=https://api.anthropic.com/v1/messages
DEFAULT_MODEL=claude-sonnet-4-6

# ---- kiwi-mem ----
MEMORY_ENABLED=true
PORT=8080
ACCESS_TOKEN=change-me-strong-password
MAX_MEMORIES_INJECT=15
MEMORY_EXTRACT_INTERVAL=3
CORS_ORIGINS=*
JIEBA_CUSTOM_WORDS=
EXTRA_REFERER=https://kiwi-mem.local
EXTRA_TITLE=kiwi-mem

# ---- PostgreSQL (由 Docker Compose 内部管理) ----
POSTGRES_USER=kiwi
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=kiwi_mem

# ---- Cloudflare Tunnel ----
# 从 Cloudflare Zero Trust dashboard 获取: One-time token
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# ---- Claude API (Telegram Bot 用) ----
ANTHROPIC_API_KEY=
